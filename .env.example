# Copy to .env and fill in. Every variable is also a flag (`--concurrency 16`);
# the flag wins. The binary reads the process environment only:
#     set -a && . ./.env && set +a && remnawave-healthcheck
# In CI, set these as secrets instead.

# ─── Required ────────────────────────────────────────────────────────────────
REMNAWAVE_PANEL_URL=https://panel.example.com
# API token created in the panel. An admin login JWT will not work.
REMNAWAVE_API_TOKEN=
# Numeric id of the monitoring user.
REMNAWAVE_USER_ID=

# ─── Telegram: both or neither. Without them the report goes to stdout only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Topic of a supergroup, a number.
TELEGRAM_THREAD_ID=

# ─── SSH ─────────────────────────────────────────────────────────────────────
# Private key text; empty → ssh-agent / ~/.ssh decide.
SSH_PRIVATE_KEY=
SSH_USER=root
SSH_PORT=22
# known_hosts text; set → StrictHostKeyChecking=yes, empty → accept-new.
SSH_KNOWN_HOSTS=
SSH_CONNECT_TIMEOUT_SECS=10
SSH_COMMAND_TIMEOUT_SECS=30

# ─── Subscription device (needed when the panel limits devices per user) ─────
REMNAWAVE_HWID=
REMNAWAVE_DEVICE_OS=linux
REMNAWAVE_DEVICE_OS_VERSION=1
REMNAWAVE_DEVICE_MODEL=remnawave-healthcheck

# ─── Tuning (defaults shown) ─────────────────────────────────────────────────
REMNAWAVE_CONCURRENCY=8
REMNAWAVE_PROBE_TIMEOUT_SECS=22
REMNAWAVE_ECHO_URL=https://api.ipify.org
REMNAWAVE_NODE_CONTAINER=remnanode
REMNAWAVE_ACME_DIR=/root/.acme.sh
REMNAWAVE_CERT_WARN_DAYS=14
REMNAWAVE_CONFIG_WARN_DAYS=7
REMNAWAVE_LOAD_WARN_FACTOR=2.0
REMNAWAVE_MEM_FREE_WARN_PCT=10
REMNAWAVE_REPUTATION_WARN_RISK=75
REMNAWAVE_GEOCHECK_TIMEOUT_SECS=90
REMNAWAVE_XRAY_CACHE=.xray-cache
REMNAWAVE_PANEL_TIMEOUT_SECS=30

# ─── Skipping families (set to true) ─────────────────────────────────────────
REMNAWAVE_NO_SSH=
REMNAWAVE_NO_CHANNELS=
REMNAWAVE_NO_GEOCHECK=
REMNAWAVE_NO_XHTTP=

# ─── Logging: info by default; debug prints raw node output and geocheck reports
RUST_LOG=info
