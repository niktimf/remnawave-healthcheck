# Copy to .env and fill in. Every setting below is also a command-line flag:
# `REMNAWAVE_CONCURRENCY=16` and `--concurrency 16` do the same thing, and the
# flag wins when both are given.
#
# The binary reads the process environment and does not open this file itself.
# Point something at it that does:
#
#     set -a && . ./.env && set +a && remnawave-healthcheck
#
# or, in compose, `env_file: .env`. In CI, set these as secrets instead — this
# file is a template, and .env itself is gitignored because it holds two tokens.

# ─── Required. The tool refuses to start without these three. ────────────────

# Base URL of the panel.
REMNAWAVE_PANEL_URL=https://panel.example.com
# API token created in the panel. An admin login JWT will not work.
REMNAWAVE_API_TOKEN=
# Subscription URL of the monitoring user; its last path segment is the
# shortUuid this tool fetches.
REMNAWAVE_SUBSCRIPTION_URL=https://sub.example.com/abcdef0123456789

# ─── Alerting. Without both of the first two the run still checks everything
# ─── and still sets its exit code; it just has nowhere to report a change.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# message_thread_id of a supergroup topic. Must be a number.
TELEGRAM_THREAD_ID=
# Link to the CI run, appended to every alert.
RUN_URL=

# ─── How the nodes are laid out. The defaults are Remnawave's own. ───────────

# Container the node's Xray runs in, as its compose file names it.
REMNAWAVE_NODE_CONTAINER=remnanode
# Directory acme.sh keeps its per-domain configuration in, no trailing slash.
REMNAWAVE_ACME_DIR=/root/.acme.sh
# How many lines of the container log to read. Also how far back the last
# config push can still be found.
REMNAWAVE_NODE_LOG_LINES=200

# These two reach a shell on every node, so they take letters, digits and
# . _ - / only. Anything else is refused before the run starts.

# ─── Thresholds ──────────────────────────────────────────────────────────────

# Warn this many days before a certificate expires.
REMNAWAVE_CERT_WARN_DAYS=14
# Warn when the node last took a config this many days ago.
REMNAWAVE_CONFIG_WARN_DAYS=7

# ─── Probing ─────────────────────────────────────────────────────────────────

# How many channels are probed at once.
REMNAWAVE_CONCURRENCY=8
# How long one channel's tunnel may take to answer.
REMNAWAVE_PROBE_TIMEOUT_SECS=22
# First local SOCKS port; each channel in a batch gets the next one. This plus
# the concurrency must stay under 65535, or the run refuses to start.
REMNAWAVE_SOCKS_BASE_PORT=10800
# Endpoint that echoes back the caller's IP address. Asked both through each
# channel's tunnel and on the node itself, so both sides of an exit comparison
# ask the same service. May not contain a quote.
REMNAWAVE_ECHO_URL=https://api.ipify.org

# ─── Files ───────────────────────────────────────────────────────────────────

# Where the previous run's problems are remembered. Deleting it makes the next
# run report every current problem as new.
REMNAWAVE_STATE_FILE=.healthcheck-state.json
# Where downloaded xray binaries are cached, one per version.
REMNAWAVE_XRAY_CACHE=.xray-cache

# ─── Skipping work. Set to `true` to turn on. A run with either of the first
# ─── two set is partial: it prints and exits, but leaves the state file and
# ─── Telegram alone, so nothing it did not look at is reported as recovered.

REMNAWAVE_NO_SSH=
REMNAWAVE_NO_CHANNELS=
# Send one test message to Telegram and exit, bypassing the diff.
REMNAWAVE_TEST_ALERT=
